  "why_this_metric": {
    "by_share": {
      "kind": "Ratio of two forecast MAEs on the same test days and training days, minus 1; near 0 means the partial view costs nothing.",
      "lie": "Different training days (one side keeping the incomplete last day): the full-view identity test requires exactly 0 at share 1.0.",
      "question": "Does seeing only part of the store cost me forecast accuracy?"
    },
    "diagnostics": {
      "kind": "Counted checks on the backtest's own inputs: what a single run over all the data would rewrite, and what the dropped last day held.",
      "lie": "A run-once implementation; tests/test_backtest.py shows the poison test fails on one.",
      "question": "Is the backtest itself honest?"
    },
    "store_est": {
      "kind": "Forecast, scored out of sample against the simulator's true daily totals; the history it learns from is this repo's estimate, re-run at each origin.",
      "lie": "Look-ahead (guarded by the poison test in tests/test_backtest.py) and Poisson arrivals by construction (no real-day shocks: see What this does NOT claim).",
      "question": "How many orders will the whole store take next week, from my own receipts?"
    },
    "store_true": {
      "kind": "Forecast trained on the TRUE totals of exactly the same training days; it is the reference for the headline.",
      "lie": "Unequal training days on the two sides (guarded by the matched-days and full-view identity tests in tests/test_backtest.py).",
      "question": "How good could the same forecast be if I saw every store order?"
    },
    "vendor": {
      "kind": "Forecast of the vendor's own daily orders, which are counted directly; truth = the simulator's realized vendor orders.",
      "lie": "The simulated vendor also sees online orders (a real vendor sees register sales only); the oracle row shows how much is pure noise.",
      "question": "How many orders will I myself get next week?"
    }
  }
}
